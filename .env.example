# =====================================================================
# TravelSphere Environment Configuration Template
# Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file containing real secrets to Git.
# =====================================================================

# Server Configuration
PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travelsphere_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Spring Security & JWT Configuration
# Generate a secure 256-bit (minimum 32-character) secret key
JWT_SECRET=your_base64_or_hex_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Secure Initial Administrator Setup
# On application startup, if no admin account exists in the database,
# the system will bootstrap this admin account with requires_password_change=true.
TRAVELSPHERE_INITIAL_ADMIN_USERNAME=admin
TRAVELSPHERE_INITIAL_ADMIN_EMAIL=admin@travelsphere.com
TRAVELSPHERE_INITIAL_ADMIN_PASSWORD=your_secure_initial_admin_password_here

# External Third-Party APIs (Do not fill with real secrets until respective steps)
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MAPS_PROVIDER=osm
MAPS_EXTERNAL_SEARCH_ENABLED=true
MAPS_TIMEOUT_MS=8000
WEATHER_PROVIDER=openweather
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL_MINUTES=15
